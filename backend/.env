# Server Configuration
ENV=development
PORT=8080
APP_URL=http://localhost:8080

# Supabase PostgreSQL Connection
# For Supabase, copy the URI from Project Settings -> Database -> Connection String (URI / Pooler)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.fzddwrdiyimpsvclhpzp:NXkiT1F3ryDtSfQW@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.fzddwrdiyimpsvclhpzp
DB_PASSWORD=postgres
DB_NAME=estatehub
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINS=60

# Redis Cache (Upstash, AWS ElastiCache, or Local Redis)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL_MINS=15

# Cryptographic JWT & Sessions
JWT_SECRET=jflsu8r3470er9fosajfSGF$ersdfjsaorowirsDTRWTdgdfusoru085380sofos
JWT_ACCESS_EXPIRY_MINS=60
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=estatehub-api

# S3 & Supabase Storage (Presigned URLs for Media & VDR Vault)
# For Supabase Storage S3 compatibility:
# S3_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
# S3_REGION=us-west-1
# S3_BUCKET=estatehub-vault
# S3_ACCESS_KEY_ID=[supabase-service-key]
# S3_SECRET_ACCESS_KEY=[supabase-anon-or-service-key]
S3_ENDPOINT=https://s3.us-west-1.amazonaws.com
S3_REGION=us-west-1
S3_BUCKET=estatehub-vault
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false
S3_PRESIGN_DURATION_MINS=30

# OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/callback/google

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://estatehub.com